# Imagen minima para ejecutar el demo de cache-aside. Evita tener que
# instalar redis-py en el equipo de cada integrante.
#
# La dependencia se instala desde scripts/requirements.txt, que es la unica
# fuente de la version. Fijarla aqui ademas duplicaria el dato y permitiria
# que la imagen quedara con una version distinta de la declarada.
FROM python:3.13-alpine

COPY scripts/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /workspace
