# Credenciales y puertos locales de la practica de Redis.
# Copiar a .env antes de levantar el compose:  cp .env.example .env
# Son valores didacticos: no reutilizarlos fuera del entorno local.

REDIS_PASSWORD=bdia_local_pass
REDIS_LISTEN_PORT=6379

# Politica de memoria de la cache.
# allkeys-lru descarta las claves menos usadas recientemente cuando se
# alcanza maxmemory. Es la politica adecuada para una cache pura.
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

REDISINSIGHT_LISTEN_PORT=5540
