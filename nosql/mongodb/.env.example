# Usuario y contrasena del administrador de MongoDB. Deben ser URL-safe: sin
# @, :, /, ? ni #. mongo-express los concatena dentro de la URI de conexion sin
# codificarlos, de modo que cualquiera de esos caracteres rompe el parseo y el
# contenedor termina con ERR_INVALID_URL.
MONGO_INITDB_ROOT_USERNAME=bdia_mongo_admin
MONGO_INITDB_ROOT_PASSWORD=bdia_mongo_pass
MONGO_DATABASE=bdia_g04_mongodb
MONGO_LISTEN_PORT=27017

ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin_local
MONGO_EXPRESS_LISTEN_PORT=8081
